# Example nginx site config for DT Trucks production.
# On the VPS, typically: /etc/nginx/sites-available/dttrucks

server {
    server_name srv1869968.hstgr.cloud 2.24.141.130 dttrucks.com www.dttrucks.com;

    client_max_body_size 25M;

    # Serve static assets directly (faster TTFB for images/fonts than Node proxy).
    location /media/ {
        alias /var/www/dttrucks/public/media/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    location /_next/static/ {
        alias /var/www/dttrucks/.next/static/;
        access_log off;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /fonts/ {
        alias /var/www/dttrucks/public/fonts/;
        access_log off;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    listen [::]:443 ssl http2 ipv6only=on;
    listen 443 ssl http2;
    ssl_certificate /etc/letsencrypt/live/srv1869968.hstgr.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/srv1869968.hstgr.cloud/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    listen [::]:80;
    server_name srv1869968.hstgr.cloud 2.24.141.130 dttrucks.com www.dttrucks.com;
    return 301 https://$host$request_uri;
}
